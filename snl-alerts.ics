DTSTART;TZID=America/New_York:20241116T233000
DTEND;TZID=America/New_York:20241117T010000
SUMMARY:SNL: Charli XCX
TRANSP:TRANSPARENT
DESCRIPTION:S50:E7\nCharli xcx does double duty on Nov. 16 in her first app
 earance as "SNL" host and third appearance as musical guest. The Grammy-no
 minated musician released her remix album\, "Brat and It's Completely Diff
 erent but Also Still Brat\," earlier this month.
BEGIN:VALARM
TRIGGER:-PT5M
ACTION:DISPLAY
DESCRIPTION:SNL starts in 5 minutes
END:VALARM
END:VEVENT
